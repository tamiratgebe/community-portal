generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum PaymentType {
  MONTHLY
  SPECIAL
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)

  payments         Payment[] @relation("MemberPayments")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  absenceRequests  AbsenceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      PaymentType
  month     Int?
  year      Int?
  method    PaymentMethod
  reference String?
  status    PaymentStatus @default(PENDING)

  memberId Int
  member   User @relation("MemberPayments", fields: [memberId], references: [id])

  verifiedById Int?
  verifiedBy   User? @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  paidAt    DateTime?
  createdAt DateTime @default(now())
}

model Meeting {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  location    String
  description String?

  absenceRequests AbsenceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id      Int    @id @default(autoincrement())
  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AbsenceRequest {
  id       Int           @id @default(autoincrement())
  reason   String
  status   RequestStatus @default(PENDING)

  memberId Int
  member   User @relation(fields: [memberId], references: [id])

  meetingId Int
  meeting   Meeting @relation(fields: [meetingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
